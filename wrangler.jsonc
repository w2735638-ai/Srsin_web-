{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "srsin-web",
  "main": "dist/worker.js",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "single-page-application"
  }
}

